{
  "name": "dsh-plugin-chudai-patrol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "巡检司 · DSH 内部看门狗：6 项健康巡检（插件加载/会话/记忆/工具/看门狗/daemon）+ 面板 + 工具。★与 core/memory-v2/daemon-guardian 分工：guardian 管「进程活着」，本插件管「DSH 内部健康」。",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "cordis.patch.yml",
    "package.json"
  ],
  "dsh": {
    "host": "index.mjs",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT"
}
